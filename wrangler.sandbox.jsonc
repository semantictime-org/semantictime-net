// sandbox リポジトリ（semantictime-net-sandbox）のデプロイ先。ワークフローの試験に使う（設計書 9.1）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semantictime-sandbox",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
