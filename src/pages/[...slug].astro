---
// 記事のページ。型に応じてテンプレートを切り替える（LAYOUT_BY_TYPE）。
// 下書きは PUBLIC_DEPLOY_ENV=preview のときだけ作る（設計書 2.3「下書きと .md 版」）。
import type { GetStaticPaths } from 'astro';
import { getEntries, getEntry, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import ComparisonLayout from '../layouts/ComparisonLayout.astro';
import DigestLayout from '../layouts/DigestLayout.astro';
import HubLayout from '../layouts/HubLayout.astro';
import ReferenceLayout from '../layouts/ReferenceLayout.astro';
import ScrollPre from '../components/mdx/ScrollPre.astro';
import ScrollTable from '../components/mdx/ScrollTable.astro';
import {
  disclosureOf,
  strongestFeatureStatus,
  verificationRecordOf,
  verifiedWithLines,
} from '../lib/article-meta';
import type { ArticlePage } from '../lib/article-page';
import {
  articleHref,
  breadcrumbsOf,
  CHANGE_LABEL,
  historyOf,
  LEVEL_LABEL,
  ROUTES,
  ROLE_LABEL,
  seriesHref,
  TYPE_EN,
  TYPE_LABEL,
} from '../lib/article-view';
import { stationLabel } from '../lib/catalog';
import { toJstDate } from '../lib/dates';
import { ogImagePath } from '../lib/og-image';
import { LAYOUT_BY_TYPE } from '../lib/taxonomy';
import { publishedArticles } from '../queries/articles';
import { loadCatalog } from '../queries/catalog';
import { articleNav } from '../lib/related';
import { buildHub } from '../queries/hub';

export const getStaticPaths = (async () => {
  const articles = await publishedArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const NUMBERED_TYPES: readonly string[] = ['tutorial', 'how-to'];

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { data } = entry;
const productRef = data.products[0];
const product = productRef ? await getEntry(productRef) : undefined;
const features = await getEntries(data.features);
const author = await getEntry(data.owner);
const series = data.series ? await getEntry(data.series.id) : undefined;
const station =
  product && data.stationNo !== undefined
    ? stationLabel(product.data.code, data.stationNo)
    : undefined;
const versions = verifiedWithLines(data.verifiedWith);
const isNews = data.type === 'news';
// ニュースの透かしとパンくずには、公開日（11.14）を使う
const newsDate = toJstDate(data.publishedAt).slice(5).replace('-', '.');
const banner = strongestFeatureStatus(features.map((f) => f.data.status));
const { Content, headings } = await render(entry);
// 本文の表とコードを、キーボードで届くスクロール領域に差し替える
const components = { table: ScrollTable, pre: ScrollPre };

// 記事の最後の案内。下書きの扱いは publishedArticles と同じ（loadCatalog がそれを使う）
const catalog = await loadCatalog();
const navOf = (id: string | undefined) => {
  const s = id === undefined ? undefined : catalog.summaryById.get(id);
  return s && { href: s.href, title: s.title, station: s.station };
};
const nav = articleNav(
  {
    id: entry.id,
    type: data.type,
    products: data.products.map((p) => p.id),
    ...(data.stationNo === undefined ? {} : { stationNo: data.stationNo }),
    ...(data.series ? { series: { id: data.series.id.id, no: data.series.no } } : {}),
  },
  catalog.articles.map((a) => ({
    id: a.id,
    type: a.data.type,
    products: a.data.products.map((p) => p.id),
    ...(a.data.stationNo === undefined ? {} : { stationNo: a.data.stationNo }),
    ...(a.data.series ? { series: { id: a.data.series.id.id, no: a.data.series.no } } : {}),
  })),
);

const page: ArticlePage = {
  id: entry.id,
  title: data.title,
  description: data.description,
  typeLabel: TYPE_LABEL[data.type],
  typeEn: TYPE_EN[data.type],
  numbered: NUMBERED_TYPES.includes(data.type),
  productName: product?.data.name,
  series:
    series && data.series
      ? {
          name: series.data.name,
          label: `連載「${series.data.name}」第 ${data.series.no} 回`,
          href: seriesHref(series.id),
        }
      : undefined,
  stationLabel: station,
  watermark: isNews ? newsDate : station,
  levelLabel: LEVEL_LABEL[data.level],
  searchFilters: [
    ...(product ? [{ key: '製品', value: product.data.name }] : []),
    { key: '種類', value: TYPE_LABEL[data.type] },
    ...data.roles.map((r) => ({ key: '読む人', value: ROLE_LABEL[r] })),
  ],
  publishedDate: toJstDate(data.publishedAt),
  crumbs: isNews
    ? [
        { label: 'ホーム', href: ROUTES.home },
        { label: 'ニュース', href: ROUTES.news },
        { label: newsDate },
      ]
    : breadcrumbsOf(product && { id: product.id, name: product.data.name }, station ?? data.title),
  record: verificationRecordOf(
    {
      verification: data.verification,
      verifiedAt: data.verifiedAt,
      type: data.type,
      categories: product?.data.categories ?? [],
    },
    new Date(),
  ),
  versions,
  disclosure: disclosureOf({
    aiAssisted: data.aiAssisted,
    author: author.data.name,
    verifiedAt: data.verifiedAt,
    versions,
  }),
  banner: banner && {
    status: banner,
    features: features.filter((f) => f.data.status === banner).map((f) => f.data.name),
  },
  history: historyOf(data.verification, data.publishedAt, data.verifiedAt),
  sources: data.sources,
  nav: {
    prev: navOf(nav.prev),
    next: navOf(nav.next),
    related: nav.related.flatMap((id) => navOf(id) ?? []),
  },
  headings,
  seo: {
    author: author.data.name,
    publishedAt: data.publishedAt,
    modifiedAt: data.verifiedAt > data.publishedAt ? data.verifiedAt : data.publishedAt,
    image: ogImagePath(entry.id),
  },
};

const template = LAYOUT_BY_TYPE[data.type];
const siblings =
  template === 'reference' && product
    ? (await publishedArticles())
        .filter((a) => a.data.type === 'reference' && a.data.products[0]?.id === product.id)
        .toSorted((a, b) => (a.data.stationNo ?? 0) - (b.data.stationNo ?? 0))
        .map((a) => ({
          label: stationLabel(product.data.code, a.data.stationNo ?? 0),
          title: a.data.title,
          href: articleHref(a.id),
          current: a.id === entry.id,
        }))
    : [];

const productNames = new Map(
  (await getEntries((data.changes ?? []).map((c) => c.product))).map((p) => [p.id, p.data.name]),
);
const changes = (data.changes ?? []).map((c) => ({
  date: c.date,
  product: c.product.id,
  productName: productNames.get(c.product.id) ?? c.product.id,
  breaking: c.breaking,
  categoryLabel: CHANGE_LABEL[c.category],
  title: c.title,
  url: c.url,
}));
const hub = template === 'hub' && product ? buildHub(product.id, await loadCatalog()) : undefined;
---

{hub ? (
  <HubLayout {...hub} title={data.title} lead={data.description} article={page.seo}>
    <Content components={components} />
  </HubLayout>
) : template === 'digest' ? (
  <DigestLayout page={page} changes={changes}>
    <Content components={components} />
  </DigestLayout>
) : template === 'reference' ? (
  <ReferenceLayout page={page} siblings={siblings}>
    <Content components={components} />
  </ReferenceLayout>
) : template === 'comparison' ? (
  <ComparisonLayout page={page}>
    <Content components={components} />
  </ComparisonLayout>
) : (
  <ArticleLayout page={page}>
    <Content components={components} />
  </ArticleLayout>
)}
