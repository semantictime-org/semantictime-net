---
// ホーム。AI Watch 型の新しい順の流れ（トップ記事 → 公開日ごとの一覧）と、右の列に連載・会社と製品。
// 会社と製品は vendors.yaml の order の順に、同じ扱いで並べる（T317）。
// 「今朝の確認時刻」と「変更の記録」の帯は、上流の取得（Phase 5）ができてから足す。
import { getCollection } from 'astro:content';
import { SITE } from '../../site.config';
import ArticleTile from '../components/article/ArticleTile.astro';
import StatePill from '../components/status/StatePill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTES, seriesHref, TYPE_LABEL } from '../lib/article-view';
import { toJstDate } from '../lib/dates';
import { buildFrontPage, EMPTY_VENDOR } from '../lib/home';
import { loadCatalog, type ArticleSummary } from '../queries/catalog';

const TOP_COUNT = 3;

const [catalog, seriesList] = await Promise.all([loadCatalog(), getCollection('series')]);
// landing（製品のハブそのもの）は流れに入れない
const listed = [...catalog.summaryById.values()].filter((a) => a.entry.data.type !== 'landing');
const front = buildFrontPage(
  listed.map((a) => ({ id: a.id, publishedAt: a.entry.data.publishedAt, summary: a })),
  TOP_COUNT,
);

const dayLabel = new Intl.DateTimeFormat('ja-JP', {
  timeZone: SITE.timezone,
  month: 'long',
  day: 'numeric',
  weekday: 'short',
});
const tileOf = (a: ArticleSummary) =>
  a.entry.data.type === 'news'
    ? { mark: 'NEWS', sub: toJstDate(a.entry.data.publishedAt).slice(5).replace('-', '.') }
    : { mark: a.station ?? a.productName ?? '', sub: a.productName };
const metaOf = (a: ArticleSummary) =>
  [a.productName, TYPE_LABEL[a.entry.data.type], toJstDate(a.entry.data.publishedAt)]
    .filter(Boolean)
    .join(' · ');

// 右の列：会社ごとの製品。記事のある製品だけハブへリンクする
const countByProduct = Map.groupBy(
  catalog.catalogArticles.filter((a) => a.type !== 'news' && a.type !== 'landing'),
  (a) => a.products[0] ?? '',
);
const vendors = catalog.vendors
  .toSorted((a, b) => a.data.order - b.data.order)
  .map((v) => ({
    name: v.data.name,
    products: catalog.products
      .filter((p) => p.data.vendor.id === v.id)
      .map((p) => ({
        name: p.data.name,
        count: countByProduct.get(p.id)?.length ?? 0,
        href: catalog.hubProductIds.has(p.id) ? `/${p.id}/` : undefined,
      })),
  }));

// 右の列：連載。公開済みの回がある連載だけリンクする
const series = seriesList
  .toSorted((a, b) => a.data.order - b.data.order)
  .map((s) => {
    const count = catalog.articles.filter((a) => a.data.series?.id.id === s.id).length;
    return { name: s.data.name, count, href: count > 0 ? seriesHref(s.id) : undefined };
  });

const vendorOrder = new Map(catalog.vendors.map((v) => [v.id, v.data.order]));
const credits = catalog.products
  .toSorted(
    (a, b) => (vendorOrder.get(a.data.vendor.id) ?? 0) - (vendorOrder.get(b.data.vendor.id) ?? 0),
  )
  .map((p) => ({
    name: p.data.name,
    href: catalog.hubProductIds.has(p.id) ? `/${p.id}/` : undefined,
  }));
---

<BaseLayout title={SITE.tagline} description={SITE.description}>
  <section class="hero" aria-labelledby="home-title">
    <div class="inner">
      <h1 id="home-title">その手順、いま動きますか。</h1>
      <p class="lead">
        手元で動かした日と版をつけて公開しています。公式が変われば、確かめ直します。
      </p>
      <ul class="credits" aria-label="扱う製品">
        {credits.map((c) => (
          <li>{c.href ? <a href={c.href}>{c.name}</a> : c.name}</li>
        ))}
      </ul>
    </div>
  </section>

  <div class="body">
    <div class="main">
      {front.top.length === 0 ? (
        <p class="empty">{EMPTY_VENDOR}手元で確かめた記事から、順に公開します。</p>
      ) : (
        <section aria-labelledby="top-title">
          <h2 id="top-title" class="label">
            トップ記事
          </h2>
          <ol class="top" data-top>
            {front.top.map(({ summary: a }, i) => (
              <li class:list={{ first: i === 0 }}>
                <a href={a.href}>
                  <ArticleTile {...tileOf(a)} />
                  <span class="text">
                    <span class="title">{a.title}</span>
                    {i === 0 && <span class="desc">{a.entry.data.description}</span>}
                    <span class="meta">{metaOf(a)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      {front.days.length > 0 && (
        <section aria-labelledby="river-title" data-river>
          <h2 id="river-title" class="label">
            新着
          </h2>
          {front.days.map((day) => (
            <section class="day" aria-label={day.date}>
              <h3>
                <time datetime={day.date}>{dayLabel.format(new Date(day.date))}</time>
              </h3>
              <ol class="river">
                {day.items.map(({ summary: a }) => (
                  <li>
                    <a href={a.href}>
                      <ArticleTile {...tileOf(a)} />
                      <span class="text">
                        <span class="title">{a.title}</span>
                        <span class="meta">{metaOf(a)}</span>
                      </span>
                      <StatePill state={a.record.state} label={a.record.stateLabel} />
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </section>
      )}
    </div>

    <aside class="side" aria-label="連載と製品">
      <section id="series" aria-labelledby="series-title">
        <h2 id="series-title" class="label">
          連載
        </h2>
        <ul class="plain">
          {series.map((s) => (
            <li>
              {s.href ? <a href={s.href}>{s.name}</a> : <span>{s.name}</span>}
              <span class="count">{s.count > 0 ? `${s.count} 回` : '準備中'}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="vendors" aria-labelledby="vendors-title">
        <h2 id="vendors-title" class="label">
          会社と製品
        </h2>
        {vendors.map((v) => (
          <section class="vendor" aria-label={v.name}>
            <h3>{v.name}</h3>
            <ul class="plain">
              {v.products.map((p) => (
                <li>
                  {p.href ? <a href={p.href}>{p.name}</a> : <span>{p.name}</span>}
                  <span class="count">{p.count > 0 ? `${p.count} 本` : '準備中'}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>

      <p class="more">
        <a href={ROUTES.news}>ニュースの一覧 →</a>
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .hero {
    container-type: inline-size;
    padding-block: var(--space-10) var(--space-6);
    background: var(--color-band);
    color: var(--color-on-band);
  }

  .inner,
  .body {
    width: calc(100% - 2 * var(--gutter-wide));
    max-width: var(--page-max);
    margin-inline: auto;
  }

  h1 {
    margin: 0;
    color: var(--color-on-band);
    font-size: var(--text-section-ja);
  }

  .lead {
    margin: var(--space-2) 0 0;
    color: var(--color-on-band-muted);
    font-size: var(--text-nav);
  }

  .credits {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-block-start: 1px solid var(--color-band-rule);
    color: var(--color-on-band-faint);
    font-size: var(--text-small);
    list-style: none;
  }

  .credits a {
    color: var(--color-on-band);
  }

  .credits a:hover {
    color: var(--color-key-on-band);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: var(--space-10);
    align-items: start;
    padding-block: var(--space-8) var(--space-section);
  }

  .label {
    margin: 0 0 var(--space-4);
    padding-block-end: var(--space-2);
    border-block-end: 2px solid var(--color-ink);
    font-size: var(--text-nav);
  }

  .main {
    display: grid;
    gap: var(--space-10);
  }

  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-ink);
    text-decoration: none;
  }

  a:hover .title {
    color: var(--color-key);
  }

  .text {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .title {
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    line-height: var(--leading-heading);
  }

  .desc {
    color: var(--color-ink-muted);
    font-size: var(--text-nav);
  }

  .meta,
  .count {
    color: var(--color-ink-muted);
    font: var(--text-small) var(--font-data);
  }

  /* トップ：先頭は大きく、残り 2 本は横に並べる */
  .top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .top a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  .top .first {
    grid-column: 1 / -1;
  }

  .top .first a {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  .top .first .title {
    font-size: var(--text-section-ja);
  }

  .day + .day {
    margin-block-start: var(--space-6);
  }

  .day h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-ink-muted);
    font: var(--text-small) var(--font-data);
  }

  .river a {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-3);
    border-block-start: 1px solid var(--color-rule);
  }

  .side {
    display: grid;
    gap: var(--space-8);
  }

  .vendor + .vendor {
    margin-block-start: var(--space-4);
  }

  .vendor h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-nav);
  }

  .plain li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-1);
    font-size: var(--text-nav);
  }

  .plain a {
    color: var(--color-key);
  }

  .plain span:not(.count) {
    color: var(--color-ink-muted);
  }

  .more {
    margin: 0;
    font-size: var(--text-nav);
  }

  .more a {
    color: var(--color-key);
  }

  .empty {
    margin: 0;
    color: var(--color-ink-muted);
  }

  @media (max-width: 860px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .inner,
    .body {
      width: calc(100% - 2 * var(--gutter-narrow));
    }

    .top,
    .top .first a {
      grid-template-columns: minmax(0, 1fr);
    }

    .river a {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    .river a > :last-child {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
