---
import { SITE } from '../../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <div class="prose placeholder">
    <h1>{SITE.name}</h1>
    <p>準備中です。</p>
  </div>
</BaseLayout>

<style>
  .placeholder {
    margin-inline: auto;
    padding: var(--space-section) var(--gutter-narrow);
  }
</style>
