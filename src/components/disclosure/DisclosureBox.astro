---
// AI 利用の開示欄（T079）。中身は src/lib/article-meta.ts の disclosureOf が決める。
import type { Disclosure } from '../../lib/article-meta';

interface Props {
  disclosure: Disclosure;
}

const { disclosure } = Astro.props;
---

<aside class="disclosure" aria-label="執筆と検証">
  <p>{disclosure.assistance}</p>
  <p>{disclosure.verification}</p>
</aside>

<style>
  .disclosure {
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  p {
    margin: 0;
  }
</style>
