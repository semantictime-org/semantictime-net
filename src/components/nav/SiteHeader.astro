---
// サイトのヘッダー（DESIGN.md v11、キャンバスの FreshHeader）。黒い帯に記号・名前・ナビを置く。
import { ROUTES } from '../../lib/article-view';

// 狭い画面でも項目は隠さず、帯の中で横に送る（検索だけは 1 段目に残す）
const NAV = [
  { label: '製品', href: ROUTES.products },
  { label: '連載', href: ROUTES.series },
  { label: 'ニュース', href: ROUTES.news },
  { label: 'バックナンバー', href: ROUTES.archive },
] as const;
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="semantictime ホーム">
      <span class="symbol" aria-hidden="true"></span>
      <span>
        semantic<span class="time">time</span>
      </span>
    </a>
    <nav class="nav" aria-label="メイン">
      <ul class="links">
        {NAV.map((item) => (
          <li>
            <a class="link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="link search" href={ROUTES.search}>
        記事検索
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    container-type: inline-size;
    background: var(--color-band);
    color: var(--color-on-band);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gutter-narrow);
    width: calc(100% - 2 * var(--gutter-wide));
    max-width: var(--page-max);
    height: var(--header-height);
    margin-inline: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-on-band);
    font: 600 var(--text-brand) var(--font-data);
    letter-spacing: var(--tracking-brand);
    text-decoration: none;
  }

  .symbol {
    display: inline-block;
    flex-shrink: 0;
    width: 0.96em;
    height: 1.12em;
    background: var(--color-key-on-band);
    clip-path: polygon(
      0 0,
      100% 0,
      100% 23%,
      35% 23%,
      35% 42%,
      85% 42%,
      85% 65%,
      35% 65%,
      35% 100%,
      0 100%
    );
  }

  .time {
    color: var(--color-key-on-band);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .links {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    padding-block: var(--space-2);
    color: var(--color-on-band);
    font-size: var(--text-nav);
    text-decoration: none;
    white-space: nowrap;
  }

  .link:hover {
    color: var(--color-key-on-band);
  }

  .search {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-band-rule);
  }

  .brand:focus-visible,
  .link:focus-visible {
    outline-color: var(--color-key-on-band);
    outline-offset: var(--space-1);
  }

  @container (max-width: 700px) {
    .inner {
      flex-wrap: wrap;
      width: calc(100% - 2 * var(--gutter-narrow));
      height: auto;
      min-height: var(--header-height-narrow);
      gap: 0 var(--space-3);
    }

    .brand {
      gap: var(--space-2);
      height: var(--header-height-narrow);
      font-size: var(--text-brand-narrow);
    }

    /* 2 段目：ロゴの下に全幅で置き、はみ出す分は横に送る */
    .nav {
      display: contents;
    }

    .search {
      margin-inline-start: auto;
    }

    .links {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-block: var(--space-1) var(--space-2);
      border-block-start: 1px solid var(--color-band-rule);
      scrollbar-width: none;
    }
  }
</style>
