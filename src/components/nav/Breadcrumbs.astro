---
// パンくず。ページ冒頭の黒い帯の先頭に置く（DESIGN.md の Layout）。最後の項目は現在のページ。
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: readonly Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="パンくずリスト">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-on-band-faint);
    font: var(--text-data) var(--font-data);
  }

  li + li::before {
    content: '/';
    margin-inline-end: var(--space-2);
  }

  a {
    color: var(--color-on-band-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-key-on-band);
  }
</style>
