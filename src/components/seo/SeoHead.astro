---
// <head> のメタ情報。何を出すかは src/lib/seo.ts の buildSeo が決める。
import { SITE } from '../../../site.config';
import { OG_HEIGHT, OG_WIDTH } from '../../lib/og-image';
import { buildSeo, parseDeployEnv, type SeoArticle } from '../../lib/seo';

interface Props {
  title: string;
  description: string;
  article?: SeoArticle | undefined;
}

const { title, description, article } = Astro.props;
const BEACON_SRC = 'https://static.cloudflareinsights.com/beacon.min.js';
// RSS の自動発見（src/pages/rss.xml.ts が作る）
const RSS_PATH = '/rss.xml';

const seo = buildSeo({
  siteUrl: SITE.url,
  siteName: SITE.name,
  title,
  description,
  path: Astro.url.pathname,
  analyticsToken: SITE.analyticsToken,
  env: parseDeployEnv(import.meta.env.PUBLIC_DEPLOY_ENV),
  ...(article ? { article } : {}),
});
// </script> で JSON-LD の外に出られないように < を逃がす
const jsonLd = JSON.stringify(seo.jsonLd).replaceAll('<', '\\u003c');
---

<title>{seo.documentTitle}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
{seo.robots && <meta name="robots" content={seo.robots} />}
<meta property="og:type" content={seo.og.type} />
<meta property="og:url" content={seo.og.url} />
<meta property="og:title" content={seo.og.title} />
<meta property="og:description" content={seo.og.description} />
<meta property="og:site_name" content={seo.og.siteName} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:image" content={seo.og.image} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={RSS_PATH} />
<script type="application/ld+json" is:inline set:html={jsonLd} />
{seo.analyticsToken && (
  <script
    is:inline
    defer
    src={BEACON_SRC}
    data-cf-beacon={JSON.stringify({ token: seo.analyticsToken })}
  />
)}
