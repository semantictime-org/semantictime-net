// 本番の Worker（設計書 9.1）。静的なファイルだけを配る（Worker のコードはない）。
// _headers と _redirects は dist/ にあるものを Cloudflare がそのまま使う。
// 独自ドメインは、ゾーンが Cloudflare で有効（ネームサーバーの切り替え後）になってから使える（Task 4.3）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semantictime",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "semantictime.net", "custom_domain": true },
    { "pattern": "www.semantictime.net", "custom_domain": true },
  ],
}
