// 本番の Worker（設計書 9.1）。静的なファイルだけを配る（Worker のコードはない）。
// _headers と _redirects は dist/ にあるものを Cloudflare がそのまま使う。
// 独自ドメイン（semantictime.net と www）はダッシュボードで付ける。CI のトークンは「この Worker 専用」で、
// ゾーンの権限がなく wrangler からは独自ドメインを設定できないため、ここには routes を書かない（docs/runbook.md）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semantictime",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
