{
  "name": "semantictime-net",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "check": "npm run lint && npm run lint:content && npm run lint:text && npm run typecheck && npm run test && npm run build",
    "check:publish-dates": "node scripts/check-publish-dates.ts",
    "check:verification-gate": "node scripts/check-verification-gate.ts",
    "reset-verification": "node scripts/reset-verification.ts",
    "lint:content": "node scripts/lint-content.ts",
    "stale-report": "node scripts/stale-report.ts",
    "lint:text": "files=$(find src/content/articles -type f \\( -name '*.md' -o -name '*.mdx' \\)); if [ -z \"$files\" ]; then echo '文章の検査: 対象の記事なし'; else textlint $files; fi",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "1.6.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
